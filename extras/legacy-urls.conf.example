# Правила nginx для сайта, переехавшего на WordPress с другой CMS.
#
# ЗАЧЕМ ЭТО НУЖНО
#
# У WordPress есть штатное правило: /search/что-угодно превращается в запрос
# ?s=что-угодно, то есть в полнотекстовый поиск по всем записям. Если на старом
# сайте были адреса, начинающиеся с /search/, каждый заход краулера по такому
# адресу запускает поиск. На базе в несколько десятков тысяч записей он
# выполняется десятками секунд и занимает воркер PHP-FPM целиком.
#
# Нескольких таких запросов в сутки достаточно, чтобы сайт перестал отвечать
# при полностью живом сервере. Поэтому мусорные адреса лучше обрубать до PHP.
#
# 410 вместо 404 — сознательно: поисковые системы выкидывают такие адреса из
# индекса быстрее и перестают их обходить.
#
# КАК ПОДКЛЮЧИТЬ
#
#   sudo cp legacy-urls.conf.example \
#        /etc/nginx/wp-autoinstall/ВАШ-ДОМЕН.d/10-legacy.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Либо сразу при установке:  sudo ./install.sh --extra-conf путь/к/файлу.conf
#
# КАК ПРОВЕРИТЬ
#
#   curl -sI -m 5 http://127.0.0.1/search/x -H "Host: ВАШ-ДОМЕН" | head -1   # 410
#
# КАК СОБРАТЬ СПИСОК СВОИХ СТАРЫХ АДРЕСОВ
#
#   awk '$9==404 {print $7}' /var/log/nginx/ВАШ-ДОМЕН.access.log \
#     | cut -d/ -f2 | sort | uniq -c | sort -rn | head -30
#
# По каждому префиксу решите: 301 на новую страницу или 410, если её больше нет.

# --- Адреса старого поиска: не пускать в PHP ---
location ^~ /search/ { return 410; }

# --- Мусор в параметре ?s= (подставьте свои характерные куски старых адресов) ---
# if ($arg_s ~* "устаревший-префикс|/tt/") { return 410; }

# --- Сканеры уязвимостей: снимают лишнюю нагрузку с PHP ---
location ~ /\.(env|git|svn|htaccess)$ { return 404; }

# --- Если поиск по сайту на время миграции не нужен вообще ---
# if ($arg_s) { return 429; }

# --- Разделы старого сайта: примеры ---
# location ^~ /old-section/ { return 410; }
# location ^~ /категория/   { return 301 https://$host/category/; }
